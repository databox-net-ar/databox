# api/.htaccess
# ---------------------------------------------------------------------------
# URLS SIN EXTENSION — REGLA DE TODO EL ARBOL DE api/
# ---------------------------------------------------------------------------
# Regla del proyecto: TODA llamada a cualquier microservicio servido desde este
# DocumentRoot (vhost api.databox.net.ar, puerto interno 8114 — ver
# docker/Dockerfile) tiene que funcionar sin escribir `.php`:
#
#   GET /v4/datarocket/etiquetas   ==   GET /v4/datarocket/etiquetas.php
#
# La forma con `.php` se sigue sirviendo tal cual (el rewrite es interno, no
# hay redirect): las dos son equivalentes y ninguna es "la canonica" a nivel
# servidor. La que se documenta y se le pasa a los integradores es la de
# arriba, sin extension.
#
# Este archivo es el UNICO lugar donde vive la regla, y cubre el arbol entero
# (`v4/` y lo que venga despues) porque Apache aplica el .htaccess del padre a
# todo subdirectorio que no declare reglas de rewrite propias. Habia copias
# byte a byte en `api/v4/`, `api/v4/aws/` y `api/v4/mercadopago/`: no agregaban
# nada y eran la unica forma de que la regla terminara divergiendo por carpeta.
#
# OJO AL AGREGAR UN .htaccess EN UN SUBDIRECTORIO: mod_rewrite NO hereda. Un
# `RewriteRule` en, por ejemplo, `api/v4/telegram/.htaccess` descarta ESTAS
# reglas para esa carpeta, y sus endpoints dejan de resolver sin extension sin
# que nada avise. Si hace falta un .htaccess ahi (tipico: `Require all denied`
# para blindar una carpeta interna), que no lleve directivas de rewrite — o
# que repita el bloque de abajo entero.

# Sin `-MultiViews` la negociacion de contenido de Apache resuelve la URL sin
# extension ANTES que mod_rewrite. Y cada microservicio tiene un `.md` hermano
# con el mismo basename que ademas se publica a proposito
# (`https://api.databox.net.ar/v4/claro/sims.md`), asi que
# `/v4/claro/sims` podria contestar la documentacion en vez del JSON segun el
# `Accept` del cliente. En la imagen php:8.2-apache MultiViews viene apagado;
# esto lo deja explicito para que la regla no dependa de un default.
Options -MultiViews

RewriteEngine On

# Solo se reescribe cuando la URL no es un archivo ni un directorio real y
# existe el `.php` hermano. Asi los `.md`, los assets y las carpetas siguen
# resolviendo por su cuenta, y una URL inexistente sigue dando 404 en vez de
# caer en un endpoint que no pidieron.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
# El `/?$` tolera la barra final: `/v4/claro/sims/` resuelve igual que
# `/v4/claro/sims`.
RewriteRule ^(.+?)/?$ $1.php [L]
